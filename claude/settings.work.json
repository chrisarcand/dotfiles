{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "global.anthropic.claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "global.anthropic.claude-haiku-4-5-20251001-v1:0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "global.anthropic.claude-opus-4-6-v1",
    "ANTHROPIC_SMALL_FAST_MODEL": "global.anthropic.claude-haiku-4-5-20251001-v1:0",
    "ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION": "us-east-1",
    "AWS_PROFILE": "sandbox_bedrock",
    "AWS_SDK_LOAD_CONFIG": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "DISABLE_PROMPT_CACHING": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__search",
      "Bash(grep:*)",
      "Bash(xargs ls:*)",
      "Bash(ls:*)",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "Bash(find:*)",
      "mcp__atlassian__atlassianUserInfo",
      "mcp__atlassian__getVisibleJiraProjects",
      "WebFetch(domain:github.com)",
      "Bash(claude mcp --help:*)",
      "WebFetch(domain:docs.claude.ai)",
      "Bash(claude config:*)",
      "Bash(readlink:*)",
      "Bash(chmod:*)",
      "Bash(git add:*)",
      "WebFetch(domain:developer.hashicorp.com)",
      "WebFetch(domain:www.hashicorp.com)",
      "WebFetch(domain:support.hashicorp.com)",
      "WebFetch(domain:edgeguides.rubyonrails.org)",
      "WebFetch(domain:guides.rubyonrails.org)",
      "WebFetch(domain:discuss.rubyonrails.org)",
      "WebFetch(domain:api.rubyonrails.org)",
      "Bash(git log:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "hashicorp@hashicorp-agent-skills": false,
    "technology@hashicorp-agent-skills": false,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    }
  }
}
