{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "sandbox_bedrock"
      }
    }
  },
  "permission": {
    // Favor no-prompt local work. Ask only for actions that leave the current
    // workspace, talk to remote systems, or mutate GitHub / remote git state.
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",

      // Local git is fine; remote writes still require approval.
      "git push": "ask",
      "git push *": "ask",

      // GitHub CLI defaults to ask; allow obviously read-only subcommands.
      "gh *": "ask",
      "gh auth status*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh pr list*": "allow",
      "gh pr status*": "allow",
      "gh pr view*": "allow",
      "gh repo view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh search *": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",

      // Explicitly allow common language runtimes and local package tooling.
      "python *": "allow",
      "python3 *": "allow",
      "uv *": "allow",
      "ruby *": "allow",
      "bundle *": "allow",
      "go *": "allow",
      "node *": "allow",
      "bun *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",

      // Allow basic curl GETs, but keep common mutating forms gated.
      "curl *": "allow",
      "curl * -X POST *": "ask",
      "curl * -X PUT *": "ask",
      "curl * -X PATCH *": "ask",
      "curl * -X DELETE *": "ask",
      "curl * --request POST *": "ask",
      "curl * --request PUT *": "ask",
      "curl * --request PATCH *": "ask",
      "curl * --request DELETE *": "ask",
      "curl * -d *": "ask",
      "curl * --data *": "ask",
      "curl * --data-*": "ask",
      "curl * -F *": "ask",
      "curl * --form *": "ask",
      "curl * -T *": "ask",
      "curl * --upload-file *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "sftp *": "ask",
      "rsync *": "ask",
      "chmod *": "allow",
      "opencode mcp --help*": "allow",
      "opencode config *": "allow",
      "acli *": "allow"
    },
    "webfetch": "allow",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "mcp": {
  },
  "default_agent": "build",
  "agent": {
  },

  "experimental": {
    "plan_mode": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**"
    ]
  },
  "share": "manual"
}
