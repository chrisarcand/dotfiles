{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "sandbox_bedrock"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "curl *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "readlink *": "allow",
      "chmod *": "allow",
      "git add *": "allow",
      "git log *": "allow",
      "git checkout *": "allow",
      "git pull *": "allow",
      "gh *": "allow",
      "acli *": "allow",
      "opencode mcp --help*": "allow",
      "opencode config *": "allow"
    },
    "webfetch": "ask"
  },
  "mcp": {
  },
  "default_agent": "build",
  "agent": {
  },

  "experimental": {
    "plan_mode": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**"
    ]
  },
  "share": "manual"
}
