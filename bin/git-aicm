#!/usr/bin/env bash
#
# git-aicm: AI-powered commit message generator using OpenCode

set -euo pipefail

show_help() {
    cat << 'EOF'
git-aicm: AI-Powered Commit Messages

Generate commit message text for staged changes using OpenCode.

USAGE:
    git aicm [OPTIONS]

OPTIONS:
    -b              Break staged changes into purposeful commits
    -h, --help      Show this help message

REQUIREMENTS:
    OpenCode CLI: https://opencode.ai

WORKFLOW:
    1. Stage exactly the changes you want this tool to consider.
    2. Run `git aicm` for one commit message from the staged diff.
    3. Run `git aicm -b` for a commit plan built from staged files.

EXPECTATIONS:
    - `git aicm` reads staged changes only. Unstaged tracked changes are ignored.
    - `git aicm -b` requires tracked changes to be fully staged or stashed first.
    - `git aicm -b` splits by whole staged files, not partial hunks.

CUSTOMIZATION:
    Edit the COMMIT_PROMPT and BREAKUP_PROMPT variables in this script.

EXAMPLES:
    git add <files>
    git aicm

    git add <files>
    git aicm -b

MORE INFO:
    Philosophy behind -b flag: https://chrisarcand.com/purposeful-commits/
EOF
    exit 0
}

die() {
    echo "$*" >&2
    exit 1
}

note() {
    echo "$*"
}

trim_blank_lines() {
    python3 -c 'import sys; print(sys.stdin.read().strip("\n"), end="")'
}

extract_opencode_text() {
    python3 - "$1" <<'PY2'
import json
import sys

chunks = []
with open(sys.argv[1], encoding="utf-8") as f:
    for raw_line in f:
        line = raw_line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") == "text":
            text = event.get("part", {}).get("text")
            if text:
                chunks.append(text)

print("".join(chunks), end="")
PY2
}

show_spinner() {
    local pid=$1
    local message=$2
    local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0

    while kill -0 "$pid" 2>/dev/null; do
        i=$(((i + 1) % ${#spin}))
        printf "\r%s %s" "${spin:$i:1}" "$message"
        sleep 0.1
    done
    printf "\r"
}

require_git_repo() {
    git rev-parse --git-dir >/dev/null 2>&1 || die "Error: git-aicm must be run inside a git repository."
}

require_opencode() {
    command -v opencode >/dev/null 2>&1 || die "Error: OpenCode CLI not found. Install it from: https://opencode.ai"
}

require_staged_changes() {
    if git diff --cached --quiet --ignore-submodules; then
        die "No staged changes to commit.
Use 'git add' to stage changes first."
    fi
}

has_unstaged_tracked_changes() {
    ! git diff --quiet --ignore-submodules
}

mk_git_temp_file() {
    mktemp "$GIT_DIR/$1.XXXXXX"
}

mk_git_temp_dir() {
    mktemp -d "$GIT_DIR/$1.XXXXXX"
}

cleanup() {
    local path
    for path in "${TEMP_PATHS[@]:-}"; do
        [ -n "$path" ] || continue
        rm -rf -- "$path"
    done
}

generate_with_opencode() {
    local prompt_text=$1
    local progress_message=$2
    local failure_label=$3
    local request_file
    local output_file
    local error_file
    local opencode_pid

    request_file=$(mk_git_temp_file git-aicm-request)
    output_file=$(mk_git_temp_file git-aicm-output)
    error_file=$(mk_git_temp_file git-aicm-error)
    TEMP_PATHS+=("$request_file" "$output_file" "$error_file")

    {
        printf '%s\n\n' "$prompt_text"
        printf 'Staged files:\n'
        printf '%s\n' "${STAGED_FILES[@]}"
        printf '\nGit diff:\n\n%s\n' "$DIFF"
    } > "$request_file"

    (opencode run --format json --file "$request_file" -- "Read the attached file and follow it exactly. Output only the final answer." > "$output_file" 2> "$error_file") &
    opencode_pid=$!

    show_spinner "$opencode_pid" "$progress_message"

    if ! wait "$opencode_pid"; then
        echo ""
        echo "Error: OpenCode failed to generate $failure_label."
        if [ -s "$error_file" ]; then
            cat "$error_file"
        fi
        exit 1
    fi

    OPENCODE_TEXT=$(extract_opencode_text "$output_file")
    OPENCODE_TEXT=$(trim_blank_lines <<< "$OPENCODE_TEXT")

    if [ -z "$OPENCODE_TEXT" ]; then
        echo ""
        echo "OpenCode returned no text for $failure_label."
        if [ -s "$error_file" ]; then
            cat "$error_file"
        fi
        exit 1
    fi

    echo ""
}

normalize_commit_plan() {
    local plan_text_file
    local staged_files_file

    PLAN_DIR=$(mk_git_temp_dir git-aicm-plan)
    TEMP_PATHS+=("$PLAN_DIR")

    plan_text_file=$(mk_git_temp_file git-aicm-plan-text)
    staged_files_file=$(mk_git_temp_file git-aicm-staged-files)
    TEMP_PATHS+=("$plan_text_file" "$staged_files_file")

    printf '%s\n' "$OPENCODE_TEXT" > "$plan_text_file"
    printf '%s\n' "${STAGED_FILES[@]}" > "$staged_files_file"

    python3 - "$plan_text_file" "$staged_files_file" "$PLAN_DIR" <<'PY2'
from collections import Counter
from pathlib import Path
import re
import sys

plan_text = Path(sys.argv[1]).read_text(encoding="utf-8")
staged_files = [line for line in Path(sys.argv[2]).read_text(encoding="utf-8").splitlines() if line]
plan_dir = Path(sys.argv[3])
staged_set = set(staged_files)


def cleanup_entry(entry: str) -> str:
    entry = entry.strip()
    entry = re.sub(r"^\s*(?:[-*]|\d+\.)\s*", "", entry)
    return entry.strip()


def normalize_file_entry(entry: str) -> str | None:
    entry = cleanup_entry(entry)
    if entry in staged_set:
        return entry

    match = re.match(r"^(.*?)(?::1-EOF|:entire file|:whole file| \(entire file\)| \(whole file\))$", entry)
    if match and match.group(1) in staged_set:
        return match.group(1)

    return None


commits = []
current = None
section = None

for raw_line in plan_text.splitlines():
    line = raw_line.rstrip("\n")

    if re.match(r"^===\s*COMMIT\s+\d+\s*===$", line):
        if current is not None:
            commits.append(current)
        current = {"files": [], "message_lines": []}
        section = None
        continue

    if current is None:
        continue

    marker = line.strip()
    if marker in {"FILES:", "Files:"}:
        section = "files"
        continue
    if marker in {"MESSAGE:", "Message:"}:
        section = "message"
        continue

    if section == "files":
        if line.strip():
            current["files"].append(line)
        continue

    if section == "message":
        current["message_lines"].append(line)

if current is not None:
    commits.append(current)

if not commits:
    raise SystemExit(
        "OpenCode did not return a valid commit plan. "
        "Expected one or more '=== COMMIT N ===' blocks."
    )

normalized_commits = []
unknown_entries = []

for index, commit in enumerate(commits, start=1):
    files = []
    for entry in commit["files"]:
        normalized = normalize_file_entry(entry)
        if normalized is None:
            unknown_entries.append((index, cleanup_entry(entry)))
        else:
            files.append(normalized)

    message = "\n".join(commit["message_lines"]).strip("\n")

    if not files:
        raise SystemExit(f"Commit {index} does not list any staged files.")
    if not message.strip():
        raise SystemExit(f"Commit {index} does not include a commit message.")

    normalized_commits.append({"files": files, "message": message})

if unknown_entries:
    details = "\n".join(
        f"- commit {index}: {entry}" for index, entry in unknown_entries
    )
    raise SystemExit(
        "OpenCode returned file entries that do not match the staged file list.\n"
        "git-aicm -b can only split whole staged files.\n"
        f"{details}"
    )

all_files = [file for commit in normalized_commits for file in commit["files"]]
counts = Counter(all_files)
duplicates = [file for file in staged_files if counts[file] > 1]
missing = [file for file in staged_files if counts[file] == 0]

if duplicates:
    duplicate_lines = "\n".join(f"- {file}" for file in duplicates)
    raise SystemExit(
        "OpenCode assigned the same staged file to multiple commits.\n"
        f"{duplicate_lines}"
    )

if missing:
    missing_lines = "\n".join(f"- {file}" for file in missing)
    raise SystemExit(
        "OpenCode omitted some staged files from the commit plan.\n"
        f"{missing_lines}"
    )

(plan_dir / "count").write_text(str(len(normalized_commits)), encoding="utf-8")

for index, commit in enumerate(normalized_commits, start=1):
    (plan_dir / f"{index}.files").write_text("\n".join(commit["files"]) + "\n", encoding="utf-8")
    (plan_dir / f"{index}.message").write_text(commit["message"] + "\n", encoding="utf-8")
PY2

    PLAN_COUNT=$(cat "$PLAN_DIR/count")
}

build_commit_patches() {
    local commit_number
    local files_file
    local patch_file
    local -a git_paths
    local file_path

    for commit_number in $(seq 1 "$PLAN_COUNT"); do
        files_file="$PLAN_DIR/$commit_number.files"
        patch_file="$PLAN_DIR/$commit_number.patch"
        git_paths=()

        while IFS= read -r file_path; do
            [ -n "$file_path" ] || continue
            git_paths+=("$file_path")
        done < "$files_file"

        if [ ${#git_paths[@]} -eq 0 ]; then
            die "Commit $commit_number does not contain any files."
        fi

        git diff --cached --binary -M -- "${git_paths[@]}" > "$patch_file"

        if [ ! -s "$patch_file" ]; then
            die "Commit $commit_number produced an empty patch."
        fi
    done
}

create_commit_from_plan() {
    local commit_number=$1
    local files_file=$2
    local message_file=$3
    local patch_file=$4
    local file_count

    file_count=$(python3 - "$files_file" <<'PY2'
from pathlib import Path
import sys

files = [line for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines() if line]
print(len(files))
PY2
)

    echo "Creating commit $commit_number/$PLAN_COUNT ($file_count file(s))..."

    git reset --quiet

    if ! git apply --cached --allow-binary-replacement --recount "$patch_file"; then
        die "Failed to stage commit $commit_number from the planned snapshot."
    fi

    if git diff --cached --quiet --ignore-submodules; then
        die "Commit $commit_number would be empty. Stopping before creating incorrect commits."
    fi

    if ! git commit -F "$message_file"; then
        die "Commit $commit_number failed. Earlier commits, if any, were created. The current index still contains the files for the failed commit."
    fi
}

BREAK_UP_COMMITS=false
while getopts "bh-:" opt; do
    case $opt in
        b)
            BREAK_UP_COMMITS=true
            ;;
        h)
            show_help
            ;;
        -)
            case "${OPTARG}" in
                help)
                    show_help
                    ;;
                *)
                    echo "Invalid option: --$OPTARG" >&2
                    echo "Usage: git aicm [-b] [-h|--help]"
                    exit 1
                    ;;
            esac
            ;;
        \?)
            echo "Invalid option: -$OPTARG" >&2
            echo "Usage: git aicm [-b] [-h|--help]"
            exit 1
            ;;
    esac
done

read -r -d '' COMMIT_PROMPT <<'EOF' || true
You are an expert at writing detailed, meaningful Git commit messages following conventional commit format.

You are writing a commit message for the currently STAGED changes only.

Analyze the git diff provided and generate a commit message with BOTH a subject line and a detailed body.

Format:
<type>: <subject>
[BLANK LINE - REQUIRED]
<body paragraphs explaining WHY>
[BLANK LINE between each paragraph]

Where type is one of:
- feat: A new feature
- fix: A bug fix
- docs: Documentation changes
- style: Code style changes (formatting, missing semicolons, etc)
- refactor: Code refactoring without changing functionality
- test: Adding or updating tests
- chore: Maintenance tasks, dependency updates, etc

REQUIRED Guidelines:
- Subject should be imperative mood (e.g., "add" not "added" or "adds")
- Keep subject under 50 characters
- Do not end subject with a period
- Subject should be lowercase after the type
- CRITICAL: You MUST include a completely blank line after the subject line before the body
- CRITICAL: You MUST include a completely blank line between each paragraph in the body
- ALWAYS include a detailed body section after the blank line
- Body should be written in prose format (full sentences and paragraphs)
- Body should explain WHY the changes are being made, not just WHAT was changed
- Body should provide context: What problem does this solve? Why this approach? What are the implications?
- If this change has broader impacts beyond the immediate feature (e.g., changes to shared config, performance implications, breaking changes), call those out explicitly
- Write for your future self: What will you wish you had documented when you're looking at this commit six months from now?
- Consider if this change is "making the change easy" (refactoring/prep work) or "making the easy change" (the actual feature), and explain accordingly
- Body lines should wrap at 72 characters
- Most changes should be no more than a paragraph or two. Don't be verbose just for the sake of
  being verbose. Only the most complex situations should call for several paragraphs of explanation.

Example of good commit with WHY (note the blank lines):
feat: add caching layer to user API endpoints
[← BLANK LINE HERE]
This change introduces Redis caching with a 5-minute TTL for user profile
data. We chose Redis because it's already part of our infrastructure and
handles our expected load. The 5-minute TTL balances freshness with
performance - user profiles don't change frequently enough to warrant
more aggressive cache invalidation.
[← BLANK LINE HERE]
This should reduce average response time from 200ms to ~20ms for cached
requests and significantly reduce database load during peak hours.

You may use markdown formatting like bulleted or numbered lists where appropriate
to supplement the prose description, but the majority of the body should be
written in paragraph form. Lists should only be used to clarify specific points,
not replace explanatory prose entirely.

Only respond with the commit message itself, nothing else. No additional
explanations or commentary outside the commit message. Do not wrap the output
in markdown code blocks.
EOF

read -r -d '' BREAKUP_PROMPT <<'EOF' || true
You are an expert at organizing Git commits following the "purposeful commits" philosophy.

You are planning commits for the currently STAGED changes only.

Analyze the staged diff and break it down into one or more logical, purposeful commits.
Each commit should represent a single logical step that builds toward the overall goal.

Critical tool constraints:
- This tool can split changes only by WHOLE STAGED FILES
- Never use line ranges, hunks, or partial files
- Use only file paths from the staged file list provided
- Every staged file must appear exactly once across the full plan
- If a file could fit more than one commit, keep the whole file in the best single commit

Follow these principles:
- "Make the change easy, then make the easy change" - Kent Beck
- Refactoring or preparation work should be separate commits from feature additions
- Configuration changes that have broader impact should be isolated
- Each commit should be independently understandable
- Prefer 2-4 commits when there is a natural split
- If the changes belong together, return exactly 1 commit instead of forcing a split

For each commit, provide:
1. The full staged files that belong in that commit
2. A commit message following the same format as the single commit prompt

Output this exact structure for every commit:
=== COMMIT 1 ===
FILES:
path/to/file1
path/to/file2

MESSAGE:
<type>: <subject>

<body explaining WHY>

=== COMMIT 2 ===
FILES:
path/to/file3

MESSAGE:
<type>: <subject>

<body explaining WHY>

Only respond with the commit plan in this exact format. No code fences, no extra commentary,
and no explanatory text before or after the commit blocks.
EOF

TEMP_PATHS=()
OPENCODE_TEXT=""
PLAN_DIR=""
PLAN_COUNT=0

trap cleanup EXIT

require_git_repo
require_opencode
require_staged_changes

GIT_DIR=$(git rev-parse --git-dir)
DIFF=$(git diff --cached)

STAGED_FILES=()
while IFS= read -r file_path; do
    [ -n "$file_path" ] || continue
    STAGED_FILES+=("$file_path")
done < <(git diff --cached --name-only --diff-filter=ACDMRT -M)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
    die "No staged files were found in the index."
fi

if has_unstaged_tracked_changes; then
    if [ "$BREAK_UP_COMMITS" = true ]; then
        die "Error: git aicm -b requires tracked changes to be fully staged.
Stage or stash the remaining tracked changes first."
    fi

    note "Note: using staged changes only; unstaged tracked changes will be ignored."
    echo ""
fi

if [ "$BREAK_UP_COMMITS" = true ]; then
    generate_with_opencode "$BREAKUP_PROMPT" "Generating commits with OpenCode..." "commits"
    normalize_commit_plan
    build_commit_patches

    echo "Generated commit plan:"
    echo "═════════════════════════════════════════════════════════════════"
    echo "$OPENCODE_TEXT"
    echo "═════════════════════════════════════════════════════════════════"
    echo ""

    printf "Create these commits? [Y/n] "
    read -r REPLY || REPLY=""

    if [[ "$REPLY" =~ ^[Nn]$ ]]; then
        echo "Commits cancelled."
        exit 1
    fi

    echo ""
    echo "Creating commits..."

    for commit_number in $(seq 1 "$PLAN_COUNT"); do
        create_commit_from_plan \
            "$commit_number" \
            "$PLAN_DIR/$commit_number.files" \
            "$PLAN_DIR/$commit_number.message" \
            "$PLAN_DIR/$commit_number.patch"
    done

    echo ""
    echo "Created $PLAN_COUNT commit(s) successfully!"
    exit 0
fi

generate_with_opencode "$COMMIT_PROMPT" "Generating commit with OpenCode..." "a commit message"

echo "Generated commit message:"
echo "─────────────────────────────────────────────────────────────────"
echo "$OPENCODE_TEXT"
echo "─────────────────────────────────────────────────────────────────"
echo ""

printf "Commit with this message? [Y/n/e] "
read -r REPLY || REPLY=""

case "$REPLY" in
    [eE])
        TEMP_MESSAGE_FILE=$(mk_git_temp_file git-aicm-message)
        TEMP_PATHS+=("$TEMP_MESSAGE_FILE")
        echo "$OPENCODE_TEXT" > "$TEMP_MESSAGE_FILE"

        GIT_EDITOR=$(git config core.editor || echo "${EDITOR:-vim}")
        $GIT_EDITOR "$TEMP_MESSAGE_FILE"

        if [ -s "$TEMP_MESSAGE_FILE" ]; then
            echo ""
            echo "Committing with edited message:"
            echo "─────────────────────────────────────────────────────────────────"
            cat "$TEMP_MESSAGE_FILE"
            echo "─────────────────────────────────────────────────────────────────"
            echo ""
            if ! git commit -F "$TEMP_MESSAGE_FILE"; then
                die "Commit failed. Your staged changes remain staged."
            fi
            echo "Committed with edited message."
        else
            echo "Commit cancelled (empty message)."
            exit 1
        fi
        ;;
    [nN])
        echo "Commit cancelled."
        exit 1
        ;;
    *)
        TEMP_MESSAGE_FILE=$(mk_git_temp_file git-aicm-message)
        TEMP_PATHS+=("$TEMP_MESSAGE_FILE")
        echo "$OPENCODE_TEXT" > "$TEMP_MESSAGE_FILE"
        if ! git commit -F "$TEMP_MESSAGE_FILE"; then
            die "Commit failed. Your staged changes remain staged."
        fi
        echo "Committed successfully!"
        ;;
esac
