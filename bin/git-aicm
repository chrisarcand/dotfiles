#!/usr/bin/env python3
from __future__ import annotations

import atexit
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from collections import Counter
from dataclasses import dataclass
from pathlib import Path
from typing import NoReturn

HELP_TEXT = """git-aicm: AI-Powered Commit Messages

Generate commit message text for staged changes using OpenCode.

USAGE:
    git aicm [OPTIONS]

OPTIONS:
    -b              Break staged changes into purposeful commits
    -h, --help      Show this help message

REQUIREMENTS:
    OpenCode CLI: https://opencode.ai

WORKFLOW:
    1. Stage exactly the changes you want this tool to consider.
    2. Run `git aicm` for one commit message from the staged diff.
    3. Run `git aicm -b` for a commit plan built from staged files.

EXPECTATIONS:
    - `git aicm` reads staged changes only. Unstaged tracked changes are ignored.
    - `git aicm -b` requires tracked changes to be fully staged or stashed first.
    - `git aicm -b` splits by whole staged files, not partial hunks.

CUSTOMIZATION:
    Edit the COMMIT_PROMPT and BREAKUP_PROMPT variables in this script.

EXAMPLES:
    git add <files>
    git aicm

    git add <files>
    git aicm -b

MORE INFO:
    Philosophy behind -b flag: https://chrisarcand.com/purposeful-commits/
"""

COMMIT_PROMPT = """You are an expert at writing detailed, meaningful Git commit messages following conventional commit format.

You are writing a commit message for the currently STAGED changes only.

Analyze the git diff provided and generate a commit message with BOTH a subject line and a detailed body.

Format:
<type>: <subject>
[BLANK LINE - REQUIRED]
<body paragraphs explaining WHY>
[BLANK LINE between each paragraph]

Where type is one of:
- feat: A new feature
- fix: A bug fix
- docs: Documentation changes
- style: Code style changes (formatting, missing semicolons, etc)
- refactor: Code refactoring without changing functionality
- test: Adding or updating tests
- chore: Maintenance tasks, dependency updates, etc

REQUIRED Guidelines:
- Subject should be imperative mood (e.g., "add" not "added" or "adds")
- Keep subject under 50 characters
- Do not end subject with a period
- Subject should be lowercase after the type
- CRITICAL: You MUST include a completely blank line after the subject line before the body
- CRITICAL: You MUST include a completely blank line between each paragraph in the body
- ALWAYS include a detailed body section after the blank line
- Body should be written in prose format (full sentences and paragraphs)
- Body should explain WHY the changes are being made, not just WHAT was changed
- Body should provide context: What problem does this solve? Why this approach? What are the implications?
- If this change has broader impacts beyond the immediate feature (e.g., changes to shared config, performance implications, breaking changes), call those out explicitly
- Write for your future self: What will you wish you had documented when you're looking at this commit six months from now?
- Consider if this change is "making the change easy" (refactoring/prep work) or "making the easy change" (the actual feature), and explain accordingly
- Body lines should wrap at 72 characters
- Most changes should be no more than a paragraph or two. Don't be verbose just for the sake of being verbose. Only the most complex situations should call for several paragraphs of explanation.

Example of good commit with WHY (note the blank lines):
feat: add caching layer to user API endpoints
[BLANK LINE HERE]
This change introduces Redis caching with a 5-minute TTL for user profile data. We chose Redis because it's already part of our infrastructure and handles our expected load. The 5-minute TTL balances freshness with performance - user profiles don't change frequently enough to warrant more aggressive cache invalidation.
[BLANK LINE HERE]
This should reduce average response time from 200ms to ~20ms for cached requests and significantly reduce database load during peak hours.

You may use markdown formatting like bulleted or numbered lists where appropriate to supplement the prose description, but the majority of the body should be written in paragraph form. Lists should only be used to clarify specific points, not replace explanatory prose entirely.

Only respond with the commit message itself, nothing else. No additional explanations or commentary outside the commit message. Do not wrap the output in markdown code blocks.
"""

BREAKUP_PROMPT = """You are an expert at organizing Git commits following the "purposeful commits" philosophy.

You are planning commits for the currently STAGED changes only.

Analyze the staged diff and break it down into one or more logical, purposeful commits. Each commit should represent a single logical step that builds toward the overall goal.

Critical tool constraints:
- This tool can split changes only by WHOLE STAGED FILES
- Never use line ranges, hunks, or partial files
- Use only file paths from the staged file list provided
- Every staged file must appear exactly once across the full plan
- If a file could fit more than one commit, keep the whole file in the best single commit

Follow these principles:
- "Make the change easy, then make the easy change" - Kent Beck
- Refactoring or preparation work should be separate commits from feature additions
- Configuration changes that have broader impact should be isolated
- Each commit should be independently understandable
- Prefer 2-4 commits when there is a natural split
- If the changes belong together, return exactly 1 commit instead of forcing a split

For each commit, provide:
1. The full staged files that belong in that commit
2. A commit message following the same format as the single commit prompt

Output this exact structure for every commit:
=== COMMIT 1 ===
FILES:
path/to/file1
path/to/file2

MESSAGE:
<type>: <subject>

<body explaining WHY>

=== COMMIT 2 ===
FILES:
path/to/file3

MESSAGE:
<type>: <subject>

<body explaining WHY>

Only respond with the commit plan in this exact format. No code fences, no extra commentary, and no explanatory text before or after the commit blocks.
"""

TEMP_PATHS: list[Path] = []
GIT_DIR: Path
DIFF_TEXT = ""
STAGED_FILES: list[str] = []


@dataclass
class PlannedCommit:
    files: list[str]
    message: str
    patch_path: Path
    message_path: Path

    @property
    def file_count(self) -> int:
        return len(self.files)


class Spinner:
    def __init__(self, message: str) -> None:
        self.message = message
        self.stop_event = threading.Event()
        self.thread: threading.Thread | None = None
        self.frames = ["|", "/", "-", "\\"]
        self.enabled = sys.stdout.isatty()

    def __enter__(self) -> "Spinner":
        if self.enabled:
            self.thread = threading.Thread(target=self._spin, daemon=True)
            self.thread.start()
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        if not self.enabled:
            return
        self.stop_event.set()
        if self.thread is not None:
            self.thread.join()
        sys.stdout.write("\r" + " " * (len(self.message) + 4) + "\r")
        sys.stdout.flush()

    def _spin(self) -> None:
        index = 0
        while not self.stop_event.is_set():
            frame = self.frames[index % len(self.frames)]
            sys.stdout.write(f"\r{frame} {self.message}")
            sys.stdout.flush()
            index += 1
            time.sleep(0.1)


def die(message: str) -> NoReturn:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def note(message: str) -> None:
    print(message)


def cleanup() -> None:
    for path in reversed(TEMP_PATHS):
        try:
            if path.is_dir():
                shutil.rmtree(path, ignore_errors=True)
            else:
                path.unlink(missing_ok=True)
        except OSError:
            pass


def run_command(
    command: list[str],
    *,
    check: bool = True,
    capture_output: bool = True,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            command,
            check=check,
            capture_output=capture_output,
            text=True,
            stdin=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        die(f"Command not found: {command[0]}")
    except subprocess.CalledProcessError as exc:
        raise exc


def git_command(
    *args: str,
    check: bool = True,
    capture_output: bool = True,
) -> subprocess.CompletedProcess[str]:
    return run_command(["git", *args], check=check, capture_output=capture_output)


def git_output(*args: str, check: bool = True) -> str:
    return git_command(*args, check=check).stdout.strip()


def ensure_git_repo() -> None:
    try:
        git_command("rev-parse", "--git-dir")
    except subprocess.CalledProcessError:
        die("Error: git-aicm must be run inside a git repository.")


def ensure_opencode() -> None:
    if shutil.which("opencode") is None:
        die("Error: OpenCode CLI not found. Install it from: https://opencode.ai")


def has_staged_changes() -> bool:
    result = git_command(
        "diff",
        "--cached",
        "--quiet",
        "--ignore-submodules",
        check=False,
    )
    return result.returncode != 0


def has_unstaged_tracked_changes() -> bool:
    result = git_command(
        "diff",
        "--quiet",
        "--ignore-submodules",
        check=False,
    )
    return result.returncode != 0


def make_temp_file(prefix: str, suffix: str = "") -> Path:
    fd, path = tempfile.mkstemp(prefix=prefix, suffix=suffix, dir=GIT_DIR)
    os.close(fd)
    temp_path = Path(path)
    TEMP_PATHS.append(temp_path)
    return temp_path


def make_temp_dir(prefix: str) -> Path:
    temp_path = Path(tempfile.mkdtemp(prefix=prefix, dir=GIT_DIR))
    TEMP_PATHS.append(temp_path)
    return temp_path


def trim_blank_lines(text: str) -> str:
    return text.strip("\n")


def extract_opencode_text(raw_output: str) -> str:
    chunks: list[str] = []
    for raw_line in raw_output.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") != "text":
            continue
        part = event.get("part") or {}
        text = part.get("text")
        if text:
            chunks.append(text)
    return "".join(chunks)


def build_request_text(prompt_text: str) -> str:
    staged_listing = "\n".join(STAGED_FILES)
    return (
        f"{prompt_text}\n\n"
        f"Staged files:\n{staged_listing}\n\n"
        f"Git diff:\n\n{DIFF_TEXT}\n"
    )


def generate_with_opencode(
    prompt_text: str,
    progress_message: str,
    failure_label: str,
) -> str:
    request_path = make_temp_file("git-aicm-request.", ".txt")
    request_path.write_text(build_request_text(prompt_text), encoding="utf-8")

    command = [
        "opencode",
        "run",
        "--format",
        "json",
        "--file",
        str(request_path),
        "--",
        "Read the attached file and follow it exactly. Output only the final answer.",
    ]

    with Spinner(progress_message):
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            stdin=subprocess.DEVNULL,
        )

    if result.returncode != 0:
        message = f"Error: OpenCode failed to generate {failure_label}."
        if result.stderr.strip():
            message = f"{message}\n{result.stderr.rstrip()}"
        die(message)

    text = trim_blank_lines(extract_opencode_text(result.stdout))
    if not text:
        message = f"OpenCode returned no text for {failure_label}."
        if result.stderr.strip():
            message = f"{message}\n{result.stderr.rstrip()}"
        die(message)

    return text


def cleanup_entry(entry: str) -> str:
    entry = entry.strip()
    entry = re.sub(r"^\s*(?:[-*]|\d+\.)\s*", "", entry)
    return entry.strip()


def normalize_file_entry(entry: str, staged_set: set[str]) -> str | None:
    cleaned = cleanup_entry(entry)
    if cleaned in staged_set:
        return cleaned

    suffix_match = re.match(
        r"^(.*?)(?::\s*(?:1-EOF|entire file|whole file)|\s+\((?:entire file|whole file)\))$",
        cleaned,
        re.IGNORECASE,
    )
    if suffix_match:
        candidate = suffix_match.group(1).strip()
        if candidate in staged_set:
            return candidate

    return None


def split_inline_files(value: str) -> list[str]:
    if not value.strip():
        return []
    return [part.strip() for part in value.split(",") if part.strip()]


def parse_commit_plan(plan_text: str) -> list[tuple[list[str], str]]:
    header_pattern = re.compile(r"^===\s*COMMIT\s+\d+\s*===$")
    files_pattern = re.compile(r"^(FILES|Files):\s*(.*)$")
    message_pattern = re.compile(r"^(MESSAGE|Message):\s*(.*)$")

    raw_commits: list[dict[str, list[str]]] = []
    current: dict[str, list[str]] | None = None
    section: str | None = None

    for raw_line in plan_text.splitlines():
        line = raw_line.rstrip("\n")

        if header_pattern.match(line.strip()):
            if current is not None:
                raw_commits.append(current)
            current = {"files": [], "message_lines": []}
            section = None
            continue

        if current is None:
            continue

        files_match = files_pattern.match(line.strip())
        if files_match:
            section = "files"
            current["files"].extend(split_inline_files(files_match.group(2)))
            continue

        message_match = message_pattern.match(line.strip())
        if message_match:
            section = "message"
            remainder = message_match.group(2).strip()
            if remainder:
                current["message_lines"].append(remainder)
            continue

        if section == "files":
            if line.strip():
                current["files"].append(line)
            continue

        if section == "message":
            current["message_lines"].append(line)

    if current is not None:
        raw_commits.append(current)

    if not raw_commits:
        die(
            "OpenCode did not return a valid commit plan. Expected one or more '=== COMMIT N ===' blocks."
        )

    staged_set = set(STAGED_FILES)
    normalized: list[tuple[list[str], str]] = []
    unknown_entries: list[tuple[int, str]] = []

    for index, raw_commit in enumerate(raw_commits, start=1):
        files: list[str] = []
        for entry in raw_commit["files"]:
            normalized_entry = normalize_file_entry(entry, staged_set)
            if normalized_entry is None:
                unknown_entries.append((index, cleanup_entry(entry)))
            else:
                files.append(normalized_entry)

        message = "\n".join(raw_commit["message_lines"]).strip("\n")

        if not files:
            die(f"Commit {index} does not list any staged files.")
        if not message.strip():
            die(f"Commit {index} does not include a commit message.")

        normalized.append((files, message))

    if unknown_entries:
        details = "\n".join(
            f"- commit {index}: {entry}" for index, entry in unknown_entries
        )
        die(
            "OpenCode returned file entries that do not match the staged file list.\n"
            "git-aicm -b can only split whole staged files.\n"
            f"{details}"
        )

    counts = Counter(file for files, _ in normalized for file in files)
    duplicates = [file for file in STAGED_FILES if counts[file] > 1]
    missing = [file for file in STAGED_FILES if counts[file] == 0]

    if duplicates:
        duplicate_lines = "\n".join(f"- {file}" for file in duplicates)
        die(
            "OpenCode assigned the same staged file to multiple commits.\n"
            f"{duplicate_lines}"
        )

    if missing:
        missing_lines = "\n".join(f"- {file}" for file in missing)
        die(
            "OpenCode omitted some staged files from the commit plan.\n"
            f"{missing_lines}"
        )

    return normalized


def prepare_commit_plan(plan_text: str) -> list[PlannedCommit]:
    normalized = parse_commit_plan(plan_text)
    plan_dir = make_temp_dir("git-aicm-plan.")
    prepared: list[PlannedCommit] = []

    for index, (files, message) in enumerate(normalized, start=1):
        patch_result = git_command(
            "diff",
            "--cached",
            "--binary",
            "-M",
            "--",
            *files,
        )
        patch_text = patch_result.stdout
        if not patch_text.strip():
            die(f"Commit {index} produced an empty patch.")

        patch_path = plan_dir / f"{index}.patch"
        patch_path.write_text(patch_text, encoding="utf-8")

        message_path = plan_dir / f"{index}.message"
        message_path.write_text(message.rstrip("\n") + "\n", encoding="utf-8")

        prepared.append(
            PlannedCommit(
                files=files,
                message=message,
                patch_path=patch_path,
                message_path=message_path,
            )
        )

    return prepared


def prompt_input(prompt: str) -> str:
    try:
        return input(prompt)
    except EOFError:
        return ""


def get_editor_command() -> str:
    configured = git_command("config", "core.editor", check=False)
    editor = configured.stdout.strip()
    if editor:
        return editor
    return os.environ.get("EDITOR", "vim")


def make_message_file(prefix: str, content: str) -> Path:
    message_path = make_temp_file(prefix, ".txt")
    message_path.write_text(content.rstrip("\n") + "\n", encoding="utf-8")
    return message_path


def commit_from_message_file(message_path: Path, failure_message: str) -> None:
    result = git_command("commit", "-F", str(message_path), check=False, capture_output=False)
    if result.returncode != 0:
        die(failure_message)


def edit_message(initial_message: str) -> Path | None:
    message_path = make_message_file("git-aicm-message.", initial_message)
    editor = get_editor_command()
    command = f"{editor} {shlex.quote(str(message_path))}"
    result = subprocess.run(command, shell=True, check=False)
    if result.returncode != 0:
        die("Editor exited with a non-zero status.")

    edited = message_path.read_text(encoding="utf-8")
    if not edited.strip():
        print("Commit cancelled (empty message).")
        return None

    print("")
    print("Committing with edited message:")
    print("-----------------------------------------------------------------")
    print(edited.rstrip("\n"))
    print("-----------------------------------------------------------------")
    print("")
    return message_path


def create_commits(plan: list[PlannedCommit]) -> None:
    total = len(plan)
    print("")
    print("Creating commits...")

    for index, planned_commit in enumerate(plan, start=1):
        print(f"Creating commit {index}/{total} ({planned_commit.file_count} file(s))...")
        git_command("reset", "--quiet", capture_output=False)

        apply_result = git_command(
            "apply",
            "--cached",
            "--allow-binary-replacement",
            "--recount",
            str(planned_commit.patch_path),
            check=False,
            capture_output=True,
        )
        if apply_result.returncode != 0:
            details = apply_result.stderr.strip()
            if details:
                die(
                    f"Failed to stage commit {index} from the planned snapshot.\n{details}"
                )
            die(f"Failed to stage commit {index} from the planned snapshot.")

        if not has_staged_changes():
            die(
                f"Commit {index} would be empty. Stopping before creating incorrect commits."
            )

        commit_from_message_file(
            planned_commit.message_path,
            (
                f"Commit {index} failed. Earlier commits, if any, were created. "
                "The current index still contains the files for the failed commit."
            ),
        )

    print("")
    print(f"Created {total} commit(s) successfully!")


def parse_args(argv: list[str]) -> bool:
    break_up_commits = False

    for arg in argv:
        if arg == "--help":
            print(HELP_TEXT)
            raise SystemExit(0)

        if arg.startswith("--"):
            die(f"Invalid option: {arg}\nUsage: git aicm [-b] [-h|--help]")

        if not arg.startswith("-") or arg == "-":
            die(f"Invalid option: {arg}\nUsage: git aicm [-b] [-h|--help]")

        for flag in arg[1:]:
            if flag == "b":
                break_up_commits = True
            elif flag == "h":
                print(HELP_TEXT)
                raise SystemExit(0)
            else:
                die(f"Invalid option: -{flag}\nUsage: git aicm [-b] [-h|--help]")

    return break_up_commits


def initialize_state() -> None:
    global GIT_DIR
    global DIFF_TEXT
    global STAGED_FILES

    ensure_git_repo()
    ensure_opencode()

    git_dir_output = git_output("rev-parse", "--git-dir")
    git_dir = Path(git_dir_output)
    if not git_dir.is_absolute():
        git_dir = (Path.cwd() / git_dir).resolve()
    GIT_DIR = git_dir

    if not has_staged_changes():
        die("No staged changes to commit.\nUse 'git add' to stage changes first.")

    DIFF_TEXT = git_output("diff", "--cached")
    STAGED_FILES = [
        line
        for line in git_output(
            "diff",
            "--cached",
            "--name-only",
            "--diff-filter=ACDMRT",
            "-M",
        ).splitlines()
        if line
    ]

    if not STAGED_FILES:
        die("No staged files were found in the index.")


def run_single_mode() -> None:
    if has_unstaged_tracked_changes():
        note("Note: using staged changes only; unstaged tracked changes will be ignored.")
        print("")

    message = generate_with_opencode(
        COMMIT_PROMPT,
        "Generating commit with OpenCode...",
        "a commit message",
    )

    print("Generated commit message:")
    print("-----------------------------------------------------------------")
    print(message)
    print("-----------------------------------------------------------------")
    print("")

    reply = prompt_input("Commit with this message? [Y/n/e] ").strip()

    if reply.lower() == "e":
        edited_path = edit_message(message)
        if edited_path is None:
            raise SystemExit(1)
        commit_from_message_file(
            edited_path,
            "Commit failed. Your staged changes remain staged.",
        )
        print("Committed with edited message.")
        return

    if reply.lower() == "n":
        print("Commit cancelled.")
        raise SystemExit(1)

    message_path = make_message_file("git-aicm-message.", message)
    commit_from_message_file(
        message_path,
        "Commit failed. Your staged changes remain staged.",
    )
    print("Committed successfully!")


def run_breakup_mode() -> None:
    if has_unstaged_tracked_changes():
        die(
            "Error: git aicm -b requires tracked changes to be fully staged.\n"
            "Stage or stash the remaining tracked changes first."
        )

    plan_text = generate_with_opencode(
        BREAKUP_PROMPT,
        "Generating commits with OpenCode...",
        "commits",
    )
    prepared_plan = prepare_commit_plan(plan_text)

    print("Generated commit plan:")
    print("=================================================================")
    print(plan_text)
    print("=================================================================")
    print("")

    reply = prompt_input("Create these commits? [Y/n] ").strip()
    if reply.lower() == "n":
        print("Commits cancelled.")
        raise SystemExit(1)

    create_commits(prepared_plan)


def main(argv: list[str]) -> None:
    break_up_commits = parse_args(argv)
    initialize_state()
    if break_up_commits:
        run_breakup_mode()
    else:
        run_single_mode()


if __name__ == "__main__":
    atexit.register(cleanup)
    main(sys.argv[1:])
